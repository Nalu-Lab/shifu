[Unit]
Description=Shifu pilot accounts
After=network-online.target

[Service]
Type=simple
User=shifu-accounts
Group=shifu-accounts
StateDirectory=shifu-accounts
StateDirectoryMode=0700
UMask=0077
WorkingDirectory=/opt/shifu-accounts
EnvironmentFile=/etc/shifu-accounts.env
Environment=SHIFU_ACCOUNTS_DB=/var/lib/shifu-accounts/accounts.sqlite
ExecStart=/usr/bin/node /opt/shifu-accounts/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
